def extrair_texto_pdf(caminho_pdf):
    """
    Extrai texto do PDF usando PyMuPDF.
    Mostra prévia das primeiras páginas para debug.
    """

    texto_completo = ""

    with fitz.open(caminho_pdf) as pdf:
        total_paginas = len(pdf)

        print(f"[INFO] Total de paginas no PDF: {total_paginas}")

        for numero_pagina, pagina in enumerate(pdf, start=1):
            texto_pagina = pagina.get_text("text")
            texto_completo += texto_pagina + "\n"

            # Mostra prévia das 3 primeiras páginas
            if numero_pagina <= 3:
                print(f"\n--- PRÉVIA TEXTO PÁGINA {numero_pagina} ---")
                print(texto_pagina[:1000])
                print("--- FIM PRÉVIA ---\n")

            if numero_pagina % 20 == 0:
                print(f"   Páginas lidas: {numero_pagina}/{total_paginas}")

    return texto_completo


def salvar_debug_texto(texto):
    """
    Salva o texto extraído do PDF para conferência.
    """

    caminho_debug = os.path.join(PASTA_ARQUIVOS_GERADOS, "debug_texto_extraido.txt")

    with open(caminho_debug, "w", encoding="utf-8") as arquivo:
        arquivo.write(texto)

    print("[INFO] Texto extraido salvo para conferencia em:")
    print(caminho_debug)


def extrair_colaboradores_da_folha(caminho_pdf):
    """
    Extrai colaboradores da folha de pagamento de forma mais robusta.

    Tentativa 1:
    - Lê linha por linha
    - Procura linha com Empr.:
    - Depois procura linha com Cargo: e C.B.O:

    Tentativa 2:
    - Usa regex no texto inteiro

    Tentativa 3:
    - Usa blocos entre Empr.: atual e próximo Empr.:
    """

    texto = extrair_texto_pdf(caminho_pdf)

    if not texto.strip():
        raise Exception(
            "Não foi possível extrair texto do PDF. "
            "O PDF pode estar escaneado. Nesse caso será necessário OCR."
        )

    salvar_debug_texto(texto)

    colaboradores = []

    # ========================================================
    # TENTATIVA 1 - LINHA POR LINHA (FORMATO COM ROTULOS QUEBRADOS)
    # ========================================================

    print("[INFO] Tentativa 1: buscando por linhas...")

    linhas = texto.splitlines()
    colaborador_atual = None

    def proxima_linha_com_texto(indice_inicial, limite=6):
        for deslocamento in range(1, limite + 1):
            idx = indice_inicial + deslocamento
            if idx >= len(linhas):
                break
            valor = limpar_texto(linhas[idx])
            if valor:
                return valor
        return ""

    for i, linha in enumerate(linhas):
        linha_limpa = limpar_texto(linha)
        linha_norm = normalizar_texto(linha_limpa)

        if not linha_limpa:
            continue

        # Caso 1: linha já vem completa com Empr., matrícula e nome
        if "EMPR.:" in linha_norm and "SITUACAO:" in linha_norm:
            padrao_empr = re.search(
                r"Empr\.\:\s*(\d+)\s+(.+?)\s+Situa..o\:",
                linha_limpa,
                re.IGNORECASE
            )
            if padrao_empr:
                colaborador_atual = {
                    "matricula": limpar_texto(padrao_empr.group(1)),
                    "nome": limpar_texto(padrao_empr.group(2)),
                    "codigo_cargo": "",
                    "funcao": "",
                    "cbo": ""
                }
                continue

        # Caso 2: no PDF atual a linha anterior contém "MATRICULA NOME"
        # e a linha atual contém apenas "Empr.:"
        if linha_norm == "EMPR.:" and i > 0:
            linha_anterior = limpar_texto(linhas[i - 1])
            match_anterior = re.match(r"^(\d+)\s+(.+)$", linha_anterior)
            if match_anterior:
                colaborador_atual = {
                    "matricula": limpar_texto(match_anterior.group(1)),
                    "nome": limpar_texto(match_anterior.group(2)),
                    "codigo_cargo": "",
                    "funcao": "",
                    "cbo": ""
                }
            continue

        # Captura cargo quando o rótulo vem em linha separada
        if colaborador_atual and linha_norm == "CARGO:":
            linha_cargo = proxima_linha_com_texto(i, limite=4)
            match_cargo = re.match(r"^(\d+)\s+(.+)$", linha_cargo)
            if match_cargo:
                colaborador_atual["codigo_cargo"] = limpar_texto(match_cargo.group(1))
                colaborador_atual["funcao"] = limpar_texto(match_cargo.group(2))
            continue

        # Captura CBO quando o rótulo vem em linha separada
        if colaborador_atual and linha_norm.startswith("C.B.O:"):
            cbo_encontrado = ""

            # Primeiro tenta na própria linha
            match_cbo_mesma_linha = re.search(r"C\.B\.O\:\s*(\d{6})", linha_limpa, re.IGNORECASE)
            if match_cbo_mesma_linha:
                cbo_encontrado = limpar_texto(match_cbo_mesma_linha.group(1))
            else:
                # Se estiver quebrado, busca nas próximas linhas
                for deslocamento in range(1, 6):
                    idx = i + deslocamento
                    if idx >= len(linhas):
                        break
                    candidato = limpar_texto(linhas[idx])
                    match_cbo = re.search(r"\b(\d{6})\b", candidato)
                    if match_cbo:
                        cbo_encontrado = limpar_texto(match_cbo.group(1))
                        break

            if cbo_encontrado:
                colaborador_atual["cbo"] = cbo_encontrado

            if (
                colaborador_atual.get("matricula")
                and colaborador_atual.get("nome")
                and colaborador_atual.get("funcao")
                and colaborador_atual.get("cbo")
            ):
                colaboradores.append(colaborador_atual)

            colaborador_atual = None
            continue

    print(f"Resultado tentativa 1: {len(colaboradores)} colaboradores")

    # ========================================================
    # TENTATIVA 2 - TEXTO INTEIRO EM UMA LINHA
    # ========================================================

    if not colaboradores:
        print("[WARN] Tentativa 1 nao encontrou colaboradores.")
        print("[INFO] Tentativa 2: buscando no texto inteiro...")

        texto_unico = limpar_texto(texto)

        padrao_bloco = re.compile(
            r"Empr\.\:\s*(\d+)\s+(.+?)\s+Situação\:.*?"
            r"Cargo\:\s*(\d+)\s+(.+?)\s+C\.B\.O\:\s*(\d+)",
            re.IGNORECASE | re.DOTALL
        )

        for match in padrao_bloco.finditer(texto_unico):
            colaboradores.append({
                "matricula": limpar_texto(match.group(1)),
                "nome": limpar_texto(match.group(2)),
                "codigo_cargo": limpar_texto(match.group(3)),
                "funcao": limpar_texto(match.group(4)),
                "cbo": limpar_texto(match.group(5))
            })

        print(f"Resultado tentativa 2: {len(colaboradores)} colaboradores")

    # ========================================================
    # TENTATIVA 3 - BLOCOS ENTRE UM EMPR E OUTRO
    # ========================================================

    if not colaboradores:
        print("[WARN] Tentativa 2 nao encontrou colaboradores.")
        print("[INFO] Tentativa 3: buscando por blocos de colaborador...")

        texto_unico = limpar_texto(texto)

        # Divide o texto em blocos começando por Empr.:
        blocos = re.split(r"(?=Empr\.\:)", texto_unico)

        for bloco in blocos:
            if "Empr.:" not in bloco or "Cargo:" not in bloco or "C.B.O:" not in bloco:
                continue

            match_empr = re.search(
                r"Empr\.\:\s*(\d+)\s+(.+?)\s+Situação\:",
                bloco,
                re.IGNORECASE
            )

            match_cargo = re.search(
                r"Cargo\:\s*(\d+)\s+(.+?)\s+C\.B\.O\:\s*(\d+)",
                bloco,
                re.IGNORECASE
            )

            if match_empr and match_cargo:
                colaboradores.append({
                    "matricula": limpar_texto(match_empr.group(1)),
                    "nome": limpar_texto(match_empr.group(2)),
                    "codigo_cargo": limpar_texto(match_cargo.group(1)),
                    "funcao": limpar_texto(match_cargo.group(2)),
                    "cbo": limpar_texto(match_cargo.group(3))
                })

        print(f"Resultado tentativa 3: {len(colaboradores)} colaboradores")

    # ========================================================
    # LIMPEZA FINAL E REMOÇÃO DE DUPLICIDADES
    # ========================================================

    unicos = {}

    for item in colaboradores:
        nome = limpar_texto(item.get("nome", ""))
        funcao = limpar_texto(item.get("funcao", ""))
        cbo = limpar_texto(item.get("cbo", ""))
        matricula = limpar_texto(item.get("matricula", ""))
        codigo_cargo = limpar_texto(item.get("codigo_cargo", ""))

        if not nome or not funcao or not cbo:
            continue

        chave = (
            normalizar_texto(matricula)
            + "|"
            + normalizar_texto(nome)
            + "|"
            + normalizar_texto(funcao)
            + "|"
            + normalizar_texto(cbo)
        )

        unicos[chave] = {
            "matricula": matricula,
            "nome": nome,
            "codigo_cargo": codigo_cargo,
            "funcao": funcao,
            "cbo": cbo
        }

    lista_final = list(unicos.values())
    lista_final.sort(key=lambda x: normalizar_texto(x["nome"]))

    print(f"[OK] Colaboradores localizados apos tratamento: {len(lista_final)}")

    if len(lista_final) == 0:
        print("\n[ERRO] Nenhum colaborador foi encontrado.")
        print("Abra o arquivo abaixo e veja se aparecem os termos Empr., Cargo e C.B.O:")
        print(os.path.join(PASTA_ARQUIVOS_GERADOS, "debug_texto_extraido.txt"))
        print("\nSe esses termos não aparecerem, o PDF provavelmente está escaneado/imagem e precisará de OCR.")

    return lista_final


