def limpar_area_destino(ws):
    """
    Limpa apenas as colunas usadas pelo script.
    """

    colunas_limpar = [
        COL_NOME,
        COL_FUNCAO,
        COL_CBO,
        COL_OBRA,
        COL_CNO_CNPJ,
        COL_REFERENCIA_ANTERIOR,
        COL_STATUS
    ]

    for linha in range(LINHA_INICIAL, ws.max_row + 1):
        for col in colunas_limpar:
            ws[f"{col}{linha}"] = None


def preencher_cabecalhos_controle(ws):
    """
    Preenche cabeçalhos nas colunas extras de conferência.
    """

    ws[f"{COL_REFERENCIA_ANTERIOR}2"] = "REFERÊNCIA MÊS ANTERIOR"
    ws[f"{COL_STATUS}2"] = "STATUS"


def gerar_nome_saida(caminho_pdf_folha):
    """
    Gera o arquivo final dentro da pasta arquivos_gerados.
    """

    nome_planilha_sem_extensao = os.path.splitext(NOME_PLANILHA_MODELO)[0]
    nome_pdf_sem_extensao = os.path.splitext(os.path.basename(caminho_pdf_folha))[0]

    data_hora = datetime.now().strftime("%Y%m%d_%H%M%S")

    nome_saida = (
        f"{nome_planilha_sem_extensao}_PREENCHIDO_"
        f"{nome_pdf_sem_extensao}_{data_hora}.xlsx"
    )

    return os.path.join(PASTA_ARQUIVOS_GERADOS, nome_saida)


# ============================================================
# FUNÇÃO PRINCIPAL
# ============================================================

def preencher_planilha():
    print("==============================================")
    print("INICIANDO PREENCHIMENTO AUTOMÁTICO")
    print("==============================================")

    criar_pastas_necessarias()
    pdf_folha = validar_arquivos()

    print("\n[INFO] Lendo folha de pagamento...")
    colaboradores = extrair_colaboradores_da_folha(pdf_folha)

    print(f"[OK] Colaboradores extraidos: {len(colaboradores)}")

    if not colaboradores:
        raise Exception(
            "Nenhum colaborador foi encontrado no PDF. "
            "Verifique o arquivo debug_texto_extraido.txt na pasta arquivos_gerados."
        )

    print("\n[INFO] Abrindo planilha modelo...")
    wb = load_workbook(PLANILHA_MODELO)

    if ABA_DESTINO not in wb.sheetnames:
        print("\n[ERRO] Aba de destino nao encontrada.")
        print("Abas disponiveis na planilha:")

        for aba in wb.sheetnames:
            print(f" - {aba}")

        raise Exception(f"Aba '{ABA_DESTINO}' não encontrada.")

    ws = wb[ABA_DESTINO]

    print("\n[INFO] Lendo referencia do mes anterior por funcao...")
    referencia_por_funcao = carregar_referencia_por_funcao(wb)

    identificador_padrao = montar_identificador_padrao()
    print(f"[INFO] Identificador padrao para funcao nova: {identificador_padrao}")

    print("\n[INFO] Limpando area de destino...")
    limpar_area_destino(ws)

    preencher_cabecalhos_controle(ws)

    colunas_estilo = [
        COL_NOME,
        COL_FUNCAO,
        COL_CBO,
        COL_OBRA,
        COL_CNO_CNPJ,
        COL_REFERENCIA_ANTERIOR,
        COL_STATUS
    ]

    linha_modelo = LINHA_INICIAL

    print("\n[INFO] Preenchendo planilha...")

    total_mantidos = 0
    total_novos = 0
    total_cbo_diferente = 0

    for indice, colaborador in enumerate(colaboradores):
        linha = LINHA_INICIAL + indice

        if linha != linha_modelo:
            copiar_estilo_linha(ws, linha_modelo, linha, colunas_estilo)

        nome = colaborador["nome"]
        funcao = colaborador["funcao"]
        cbo = colaborador["cbo"]

        chave_funcao = normalizar_texto(funcao)
        dados_funcao_anterior = referencia_por_funcao.get(chave_funcao)

        if dados_funcao_anterior:
            cno_cnpj_final = dados_funcao_anterior["cno_cnpj"]
            funcao_referencia = dados_funcao_anterior["funcao"]
            cbo_referencia = dados_funcao_anterior["cbo"]

            referencia_texto = f"{funcao_referencia} | CBO: {cbo_referencia}"

            if normalizar_texto(cbo_referencia) == normalizar_texto(cbo):
                status = "FUNÇÃO JÁ EXISTIA - CNO/CNPJ MANTIDO"
                total_mantidos += 1
            else:
                status = "FUNÇÃO EXISTIA, MAS CBO DIFERENTE - CNO/CNPJ MANTIDO"
                total_cbo_diferente += 1

        else:
            cno_cnpj_final = identificador_padrao
            referencia_texto = ""
            status = "FUNÇÃO NOVA - USADO IDENTIFICADOR PADRÃO"
            total_novos += 1

        ws[f"{COL_NOME}{linha}"] = nome
        ws[f"{COL_FUNCAO}{linha}"] = funcao
        ws[f"{COL_CBO}{linha}"] = cbo
        ws[f"{COL_OBRA}{linha}"] = OBRA_ATUAL
        ws[f"{COL_CNO_CNPJ}{linha}"] = cno_cnpj_final
        ws[f"{COL_REFERENCIA_ANTERIOR}{linha}"] = referencia_texto
        ws[f"{COL_STATUS}{linha}"] = status

    ajustar_larguras(ws)

    arquivo_saida = gerar_nome_saida(pdf_folha)

    print("\n[INFO] Salvando arquivo final...")
    wb.save(arquivo_saida)

    print("\n==============================================")
    print("PROCESSO FINALIZADO COM SUCESSO")
    print("==============================================")
    print(f"Total de colaboradores preenchidos: {len(colaboradores)}")
    print(f"Funções com CNO/CNPJ mantido do mês anterior: {total_mantidos}")
    print(f"Funções novas com identificador padrão: {total_novos}")
    print(f"Funções com CBO diferente: {total_cbo_diferente}")
    print("\nArquivo final gerado em:")
    print(arquivo_saida)


