def copiar_estilo_celula(origem, destino):
    """
    Copia o estilo de uma célula para outra.
    """

    if origem.has_style:
        destino.font = copy(origem.font)
        destino.fill = copy(origem.fill)
        destino.border = copy(origem.border)
        destino.alignment = copy(origem.alignment)
        destino.number_format = origem.number_format
        destino.protection = copy(origem.protection)


def copiar_estilo_linha(ws, linha_origem, linha_destino, colunas):
    """
    Copia estilo da linha modelo para a linha de destino.
    """

    for col in colunas:
        copiar_estilo_celula(
            ws[f"{col}{linha_origem}"],
            ws[f"{col}{linha_destino}"]
        )


def ajustar_larguras(ws):
    """
    Ajusta larguras básicas das colunas.
    """

    ws.column_dimensions[COL_NOME].width = 40
    ws.column_dimensions[COL_FUNCAO].width = 34
