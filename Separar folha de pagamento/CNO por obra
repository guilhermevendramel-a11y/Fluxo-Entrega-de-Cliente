def criar_pastas_necessarias():
    """
    Cria as pastas do projeto caso ainda não existam.
    """

    os.makedirs(PASTA_PLANILHA_MODELO, exist_ok=True)
    os.makedirs(PASTA_FOLHAS_PAGAMENTO, exist_ok=True)
    os.makedirs(PASTA_ARQUIVOS_GERADOS, exist_ok=True)


def listar_arquivos_da_pasta(pasta):
    """
    Lista arquivos disponíveis em uma pasta.
    Ajuda a identificar erro de nome.
    """

    if not os.path.exists(pasta):
        return []

    return [
        arquivo for arquivo in os.listdir(pasta)
        if os.path.isfile(os.path.join(pasta, arquivo))
    ]


def validar_arquivos():
    """
    Confere se a planilha e o PDF existem antes de rodar.
    """

    print("==============================================")
    print("VALIDANDO ARQUIVOS")
    print("==============================================")

    print(f"Pasta do projeto: {PASTA_PROJETO}")
    print(f"Planilha esperada: {PLANILHA_MODELO}")
    if not os.path.exists(PLANILHA_MODELO):
        print("\n❌ Planilha modelo não encontrada.")
        print(f"Coloque a planilha dentro da pasta: {PASTA_PLANILHA_MODELO}")
        print("\nArquivos encontrados nessa pasta:")

        arquivos = listar_arquivos_da_pasta(PASTA_PLANILHA_MODELO)

        if arquivos:
            for arquivo in arquivos:
                print(f" - {arquivo}")
        else:
            print(" Nenhum arquivo encontrado.")

        raise FileNotFoundError(f"Planilha não encontrada: {PLANILHA_MODELO}")

    pdf_folha = localizar_pdf_folha()

    if not pdf_folha:
        print("\n❌ PDF da folha de pagamento não encontrado.")
        print(f"Coloque o PDF dentro da pasta: {PASTA_FOLHAS_PAGAMENTO}")
        print("\nArquivos encontrados nessa pasta:")

        arquivos = listar_arquivos_da_pasta(PASTA_FOLHAS_PAGAMENTO)

        if arquivos:
            for arquivo in arquivos:
                print(f" - {arquivo}")
        else:
            print(" Nenhum arquivo encontrado.")

        raise FileNotFoundError(f"PDF não encontrado na pasta: {PASTA_FOLHAS_PAGAMENTO}")

    print("[OK] Planilha encontrada.")
    print(f"[OK] PDF encontrado: {pdf_folha}")
    return pdf_folha


def localizar_pdf_folha():
    """
    Localiza PDF(s) na pasta de folhas.
    Se houver mais de um, usa o mais recente por data de modificacao.
    """

    if not os.path.exists(PASTA_FOLHAS_PAGAMENTO):
        return None

    pdfs = []
    for arquivo in os.listdir(PASTA_FOLHAS_PAGAMENTO):
        caminho = os.path.join(PASTA_FOLHAS_PAGAMENTO, arquivo)
        if os.path.isfile(caminho) and arquivo.lower().endswith(".pdf"):
            pdfs.append(caminho)

    if not pdfs:
        return None

    pdfs.sort(key=os.path.getmtime, reverse=True)
    return pdfs[0]


# ============================================================
# FUNÇÕES DE TRATAMENTO DE TEXTO
# ============================================================

def normalizar_texto(texto):
    """
    Normaliza texto para comparação:
    remove acentos, deixa maiúsculo e limpa espaços.
    """

    if texto is None:
        return ""

    texto = str(texto).strip().upper()
    texto = unicodedata.normalize("NFD", texto)
    texto = "".join(c for c in texto if unicodedata.category(c) != "Mn")
    texto = re.sub(r"\s+", " ", texto)

    return texto


def limpar_texto(texto):
    """
    Limpa quebras de linha e espaços duplicados.
    """

    if texto is None:
        return ""

    texto = str(texto).replace("\n", " ")
    texto = re.sub(r"\s+", " ", texto)

    return texto.strip()


