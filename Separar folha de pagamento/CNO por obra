    ws.column_dimensions[COL_CNO_CNPJ].width = 28
    ws.column_dimensions[COL_REFERENCIA_ANTERIOR].width = 42
    ws.column_dimensions[COL_STATUS].width = 42


# ============================================================
# FUNÇÕES DE REFERÊNCIA CNO/CNPJ
# ============================================================

def montar_identificador_padrao():
    """
    Monta CNO ou CNPJ padrão para funções novas.
    """

    tipo = TIPO_IDENTIFICADOR_PADRAO.strip().upper()

    if tipo == "CNO":
        return f"CNO: {CNO_PADRAO}"

    if tipo == "CNPJ":
        return f"CNPJ: {CNPJ_PADRAO}"

    raise Exception("TIPO_IDENTIFICADOR_PADRAO precisa ser 'CNO' ou 'CNPJ'.")


def carregar_referencia_por_funcao(wb):
    """
    Lê a aba do mês anterior e cria uma referência por função.

    Regra:
    - Função está na coluna C
    - CBO está na coluna D
    - CNO/CNPJ está na coluna F

    Se a função aparecer no mês atual, o script usa o mesmo CNO/CNPJ
    que foi utilizado no mês anterior.
    """

    referencia = {}

    if not ABA_MES_ANTERIOR:
        print("[WARN] Aba do mes anterior nao informada.")
        return referencia

    if ABA_MES_ANTERIOR not in wb.sheetnames:
        print(f"[WARN] Aba '{ABA_MES_ANTERIOR}' nao encontrada.")
        print("A comparacao por funcao sera ignorada.")
        return referencia

    ws_ant = wb[ABA_MES_ANTERIOR]

    for linha in range(LINHA_INICIAL, ws_ant.max_row + 1):
        funcao = ws_ant[f"{COL_FUNCAO}{linha}"].value
        cbo = ws_ant[f"{COL_CBO}{linha}"].value
        cno_cnpj = ws_ant[f"{COL_CNO_CNPJ}{linha}"].value

        if not funcao or not cno_cnpj:
            continue

        funcao_limpa = limpar_texto(funcao)
        cbo_limpo = limpar_texto(cbo)
        cno_cnpj_limpo = limpar_texto(cno_cnpj)

        chave_funcao = normalizar_texto(funcao_limpa)

        # Mantém a primeira referência encontrada por função
        if chave_funcao not in referencia:
            referencia[chave_funcao] = {
                "funcao": funcao_limpa,
                "cbo": cbo_limpo,
                "cno_cnpj": cno_cnpj_limpo,
                "linha_origem": linha
            }

    print(f"[OK] Funcoes encontradas no mes anterior: {len(referencia)}")

    return referencia


